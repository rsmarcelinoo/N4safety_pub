# Copy this to .env and fill in your values.
# EXPO_PUBLIC_* variables are embedded at build time and visible in the bundle.
# Never put secrets here — only public URLs.

# URL of the N4Safety ASP.NET Core backend.
# Use your machine's LAN IP (not localhost) so the iOS simulator can reach it.
# Example: http://192.168.1.42:5000
EXPO_PUBLIC_API_URL=
